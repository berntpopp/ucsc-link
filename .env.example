# ucsc-link configuration
#
# Copy to .env and edit. All variables use the UCSC_LINK_ prefix.
# Nested settings use a double-underscore delimiter (e.g. UCSC_LINK_UCSC__BASE_URL).

# --- Server ---
UCSC_LINK_HOST=127.0.0.1
UCSC_LINK_ALLOW_PUBLIC_BIND=false
UCSC_LINK_PORT=8000
# transport: unified | http | stdio
UCSC_LINK_TRANSPORT=unified
UCSC_LINK_MCP_PATH=/mcp
UCSC_LINK_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'
UCSC_LINK_ALLOWED_ORIGINS='[]'
# Comma-separated list of allowed CORS origins (empty = none)
UCSC_LINK_CORS_ORIGINS=
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
UCSC_LINK_LOG_LEVEL=INFO
# log_format: json | console
UCSC_LINK_LOG_FORMAT=console

# --- UCSC upstream (nested: ucsc) ---
UCSC_LINK_UCSC__BASE_URL=https://api.genome.ucsc.edu
UCSC_LINK_UCSC__REQUEST_TIMEOUT_S=20.0
# Politeness: UCSC API help recommends <=1 hit/s; the Conditions of Use say 1 hit per 15 s
# and 5,000/day for program-driven use. Set MIN_INTERVAL_S=15 for the strict reading.
UCSC_LINK_UCSC__MIN_INTERVAL_S=1.0
UCSC_LINK_UCSC__DAILY_CAP=5000
UCSC_LINK_UCSC__MAX_WAIT_S=20.0
UCSC_LINK_UCSC__MAX_RETRIES=2
UCSC_LINK_UCSC__BACKOFF_BASE_S=2.0
# In-process response cache (no on-disk state)
UCSC_LINK_UCSC__CACHE_TTL_S=3600
UCSC_LINK_UCSC__CACHE_MAXSIZE=512
